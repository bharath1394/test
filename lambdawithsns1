const AWS = require('aws-sdk');
const { createObjectCsvStringifier } = require('csv-writer');

// Initialize S3 and SNS clients
const s3 = new AWS.S3();
const sns = new AWS.SNS();

const S3_BUCKET = 'certmanagement';
const CSV_KEY = 'csv/cert_expiry.csv';
const THRESHOLD_DAYS = 90;
const SNS_TOPIC_ARN = 'arn:aws:sns:your-region:your-account-id:your-sns-topic'; // Replace with your SNS topic ARN

exports.handler = async (event) => {
  try {
    // Download the CSV file from S3
    const csvFile = await s3.getObject({ Bucket: S3_BUCKET, Key: CSV_KEY }).promise();
    const content = csvFile.Body.toString('utf-8').splitlines();

    // Parse the CSV content
    const certificates = parseCsv(content);
    const today = new Date();
    const prodCertificates = [];
    const nonProdCertificates = [];

    // Process each certificate
    certificates.forEach(cert => {
      const validTo = new Date(cert['Valid To']);
      const daysToExpiry = Math.floor((validTo - today) / (1000 * 60 * 60 * 24));
      
      if (daysToExpiry <= THRESHOLD_DAYS) {
        if (cert.Env.toLowerCase() === 'prod') {
          prodCertificates.push(cert);
        } else {
          nonProdCertificates.push(cert);
        }
      }
    });

    // Generate the email content
    const emailContent = generateEmailContent(prodCertificates, nonProdCertificates);

    // Send the notification
    await sendSnsNotification(emailContent);

    return {
      statusCode: 200,
      body: JSON.stringify('Expiry check completed successfully.'),
    };
  } catch (error) {
    console.error('Error:', error);
    return {
      statusCode: 500,
      body: JSON.stringify(`An error occurred: ${error.message}`),
    };
  }
};

// Parse CSV data and handle headers
function parseCsv(content) {
  const headers = content[0].split(',').map(h => h.trim());
  const records = [];
  
  for (let i = 1; i < content.length; i++) {
    const row = content[i].split(',');
    if (row.length === headers.length) {
      const record = {};
      headers.forEach((header, index) => {
        record[header] = row[index]?.trim() || ''; // Handle empty fields
      });
      records.push(record);
    } else {
      console.log('Skipping incomplete certificate:', row);
    }
  }

  return records;
}

// Generate the email content
function generateEmailContent(prodCertificates, nonProdCertificates) {
  let message = '# Certificate Expiry Notification\n\n';

  if (prodCertificates.length > 0) {
    message += '## Expiring Production Certificates\n';
    message += formatCertificatesAsMarkdown(prodCertificates);
  } else {
    message += 'No production certificates expiring within the threshold.\n';
  }

  if (nonProdCertificates.length > 0) {
    message += '\n## Expiring Non-Production Certificates\n';
    message += formatCertificatesAsMarkdown(nonProdCertificates);
  } else {
    message += 'No non-production certificates expiring within the threshold.\n';
  }

  return message;
}

// Format certificates as Markdown
function formatCertificatesAsMarkdown(certificates) {
  let text = '| Title | Valid To | Environment | App Code | Application Name |\n';
  text += '|-------|----------|-------------|----------|------------------|\n';

  certificates.forEach(({ Title, 'Valid To': validTo, Env, 'APP CODE': appCode, 'Application Name': appName }) => {
    text += `| ${Title} | ${validTo} | ${Env} | ${appCode} | ${appName} |\n`;
  });

  return text;
}

// Send SNS notification
async function sendSnsNotification(message) {
  const params = {
    Message: message,
    Subject: 'Certificate Expiry Notification',
    TopicArn: SNS_TOPIC_ARN,
  };

  await sns.publish(params).promise();
}
