const csv = require('csv-parser');
const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');
const { SNSClient, PublishCommand } = require('@aws-sdk/client-sns');
const stream = require('stream');

// Initialize S3 and SNS Clients
const s3Client = new S3Client({ region: 'us-east-1' });
const snsClient = new SNSClient({ region: 'us-east-1' });

const S3_BUCKET = 'certmanagment';
const S3_OBJECT_KEY = 'csv/cert_expiry.csv';
const THRESHOLD_DAYS = 90;
const SNS_TOPIC_ARN = 'arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:cert-expiry-topic'; // Update this

exports.handler = async (event) => {
  try {
    console.log(`Fetching certificates from S3: ${S3_BUCKET}/${S3_OBJECT_KEY}`);

    const certificates = await getCertificatesFromS3(S3_BUCKET, S3_OBJECT_KEY);
    const { prodCertificates, nonProdCertificates } = separateCertificates(certificates);
    
    const expiringProdCertificates = checkExpiringCertificates(prodCertificates);
    const expiringNonProdCertificates = checkExpiringCertificates(nonProdCertificates);

    let message = generateEmailContent(expiringProdCertificates, expiringNonProdCertificates);

    if (message) {
      await sendSnsNotification(message);
    }

    return {
      statusCode: 200,
      body: JSON.stringify({ message: 'Expiry check completed successfully.' }),
    };
  } catch (error) {
    console.error('Error:', error);
    return {
      statusCode: 500,
      body: JSON.stringify({ message: `An error occurred: ${error.message}` }),
    };
  }
};

// Fetch and Parse Certificates from S3
async function getCertificatesFromS3(bucket, key) {
  const command = new GetObjectCommand({ Bucket: bucket, Key: key });

  try {
    const response = await s3Client.send(command);
    const csvData = await streamToString(response.Body);
    return parseCSV(csvData);
  } catch (error) {
    console.error('Error fetching or parsing the CSV:', error);
    throw error;
  }
}

// Convert Stream to String
const streamToString = (streamBody) =>
  new Promise((resolve, reject) => {
    const chunks = [];
    streamBody.on('data', (chunk) => chunks.push(chunk));
    streamBody.on('end', () => resolve(Buffer.concat(chunks).toString('utf-8')));
    streamBody.on('error', reject);
  });

// Parse CSV String into JavaScript Objects
function parseCSV(data) {
  const rows = [];
  return new Promise((resolve, reject) => {
    stream.Readable.from([data])
      .pipe(csv())
      .on('data', (row) => {
        const cleanedRow = cleanRow(row);
        if (cleanedRow) rows.push(cleanedRow);
      })
      .on('end', () => resolve(rows))
      .on('error', (error) => reject(error));
  });
}

// Clean and Validate Each Row
function cleanRow(row) {
  const title = row['\ufeffTitle']?.trim(); // Handle BOM in Title
  const validTo = row['Valid To']?.trim();
  const env = row['Env']?.trim();
  const appCode = row['APP CODE']?.trim();
  const appName = row['Application Name']?.trim();

  // Skip rows with missing critical fields
  if (!title || !validTo || !appName) {
    console.warn(`Skipping incomplete certificate: ${JSON.stringify(row)}`);
    return null;
  }

  return { title, validTo, env, appCode, appName };
}

// Separate Certificates into Production and Non-Production
function separateCertificates(certificates) {
  const prodCertificates = [];
  const nonProdCertificates = [];

  certificates.forEach((cert) => {
    if (cert.env.toLowerCase() === 'prod') {
      prodCertificates.push(cert);
    } else {
      nonProdCertificates.push(cert);
    }
  });

  return { prodCertificates, nonProdCertificates };
}

// Check Expiring Certificates within the Threshold
function checkExpiringCertificates(certificates) {
  const today = new Date();

  return certificates.filter(({ validTo }) => {
    const expiryDate = parseDate(validTo);
    if (isNaN(expiryDate)) {
      console.warn(`Invalid date format for certificate: ${validTo}`);
      return false;
    }
    const daysToExpiry = Math.ceil((expiryDate - today) / (1000 * 60 * 60 * 24));
    return daysToExpiry <= THRESHOLD_DAYS;
  });
}

// Parse the 'Valid To' Date (Format: mm/dd/yyyy 12:00 AM)
function parseDate(dateString) {
  try {
    const [month, day, yearAndTime] = dateString.split('/');
    const [year] = yearAndTime.split(' ');

    const date = new Date(`${year}-${month}-${day}`);
    if (isNaN(date)) {
      throw new Error('Invalid date');
    }
    return date;
  } catch (error) {
    console.error(`Error parsing date: ${dateString} - ${error.message}`);
    return NaN;
  }
}

// Generate Plain Text Content for Email Notification
function generateEmailContent(prodCertificates, nonProdCertificates) {
  let message = 'Certificate Expiry Notification\n\n';

  if (prodCertificates.length > 0) {
    message += 'Expiring Production Certificates:\n';
    message += formatCertificatesAsPlainText(prodCertificates);
  } else {
    message += 'No production certificates expiring within the threshold.\n';
  }

  if (nonProdCertificates.length > 0) {
    message += '\nExpiring Non-Production Certificates:\n';
    message += formatCertificatesAsPlainText(nonProdCertificates);
  } else {
    message += 'No non-production certificates expiring within the threshold.\n';
  }

  return message;
}

// Format Expiring Certificates as Plain Text
function formatCertificatesAsPlainText(certificates) {
  let text = '';

  certificates.forEach(({ title, validTo, env, appCode, appName }) => {
    text += `Title: ${title}\n`;
    text += `Valid To: ${validTo}\n`;
    text += `Environment: ${env}\n`;
    text += `App Code: ${appCode}\n`;
    text += `Application Name: ${appName}\n`;
    text += '-----------------------------------\n'; // Separator for each certificate
  });

  return text;
}

// Send SNS Notification
async function sendSnsNotification(message) {
  try {
    const command = new PublishCommand({
      TopicArn: SNS_TOPIC_ARN,
      Message: message,
      Subject: 'Urgent: Expiring Certificates Notification',
    });
    await snsClient.send(command);
    console.log('SNS notification sent successfully.');
  } catch (error) {
    console.error('Error sending SNS notification:', error);
  }
}
