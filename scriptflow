const fs = require('fs');
const path = require('path');

const stage = process.env.stage;
const accountId = process.env.accountId;
const TargetAccountRegion = process.env.TargetAccountRegion;
const resourceFullName = process.env.resourceFullName;

const flowConfigPath = path.resolve(__dirname, '../config/flows/flowConfig.json');
const connectInstancePath = path.resolve(__dirname, '../config/connectInstance.json');
const controllerPath = path.resolve(__dirname, '../controller.json');

function logInfo(message) {
  console.log(`[INFO] ${message}`);
}

function logWarn(message) {
  console.warn(`[WARN] ${message}`);
}

function logError(message) {
  console.error(`[ERROR] ${message}`);
}

function safeReadJson(filePath, name) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  } catch (err) {
    logError(`Failed to read ${name} at ${filePath}: ${err.message}`);
    process.exit(1);
  }
}

function getLambdaMode(controller) {
  const lambdaMode = controller?.lambda?.toUpperCase();
  if (lambdaMode === 'G' || lambdaMode === 'B') {
    return lambdaMode;
  }
  logWarn(`Missing or invalid lambda mode in controller.json. Defaulting to 'G'.`);
  return 'G';
}

function transformLambdaArns(content, lambdaMode) {
  return content.replace(
    /arn:aws:lambda:[^:]+:\d{12}:function:[^"]+/g,
    (match) => {
      const fnSuffix = match.split(':').pop()?.split('-').pop();
      const newArn = `arn:aws:lambda:${TargetAccountRegion}:${accountId}:function:${resourceFullName}-${lambdaMode}-${fnSuffix}`;
      logInfo(`Replaced Lambda ARN: ${match} → ${newArn}`);
      return newArn;
    }
  );
}

function transformFlowParameters(flowJson, instanceId) {
  const actions = flowJson.Actions || [];
  const metadata = flowJson.ActionMetaData || {};

  for (const action of actions) {
    const actionId = action.Identifier;
    const actionType = action.Type;
    const params = action.parameters;

    if (!params || !metadata[actionId] || !metadata[actionId].parameters) continue;

    const metaParams = metadata[actionId].parameters;

    if (actionType === 'TransferToFlow' && params.ContactFlowId && metaParams.ContactFlowId?.displayName) {
      const displayName = metaParams.ContactFlowId.displayName;
      const ssmValue = `\${ssm:/${stage}/flows/${displayName}/arn}`;
      logInfo(`Replaced ContactFlowId for action ${actionId}: ${params.ContactFlowId} → ${ssmValue}`);
      params.ContactFlowId = ssmValue;
    }

    if (actionType === 'InvokeFlowModule' && params.FlowModuleId && metaParams.FlowModuleId?.displayName) {
      const displayName = metaParams.FlowModuleId.displayName;
      const ssmValue = `\${ssm:/${stage}/modules/${displayName}/id}`;
      logInfo(`Replaced FlowModuleId for action ${actionId}: ${params.FlowModuleId} → ${ssmValue}`);
      params.FlowModuleId = ssmValue;
    }
  }

  return flowJson;
}

// === MAIN SCRIPT ===
logInfo(`Stage: ${stage}`);
logInfo(`Account ID: ${accountId}`);
logInfo(`Target Region: ${TargetAccountRegion}`);
logInfo(`Resource Name Prefix: ${resourceFullName}`);

const flowConfig = safeReadJson(flowConfigPath, 'flowConfig.json');
const connectInstances = safeReadJson(connectInstancePath, 'connectInstance.json');
const controller = safeReadJson(controllerPath, 'controller.json');

const lambdaMode = getLambdaMode(controller);

const flowsForStage = flowConfig[stage];
if (!flowsForStage) {
  logError(`No flows found for stage: ${stage}`);
  process.exit(1);
}

Object.entries(flowsForStage).forEach(([instanceName, flowPaths]) => {
  const instanceId = connectInstances[stage]?.[instanceName];
  if (!instanceId) {
    logWarn(`Instance ID not found for stage "${stage}", instance "${instanceName}"`);
  } else {
    logInfo(`Using Connect Instance ID for ${stage}/${instanceName}: ${instanceId}`);
  }

  flowPaths.forEach((flowRelPath) => {
    const fullFlowPath = path.resolve(__dirname, '../config/flows/', flowRelPath);
    logInfo(`Processing flow: ${flowRelPath}`);

    try {
      const originalContent = fs.readFileSync(fullFlowPath, 'utf-8');

      // Step 1: Replace Lambda ARNs in text
      const lambdaTransformed = transformLambdaArns(originalContent, lambdaMode);

      // Step 2: Replace Flow ARNs and Module IDs using Metadata
      const parsedJson = JSON.parse(lambdaTransformed);
      const updatedFlow = transformFlowParameters(parsedJson, instanceId);

      // Step 3: Write updated flow file
      fs.writeFileSync(fullFlowPath, JSON.stringify(updatedFlow, null, 2));
      logInfo(`✅ Flow updated successfully: ${flowRelPath}`);
    } catch (err) {
      logError(`❌ Failed to process flow ${flowRelPath}: ${err.message}`);
    }
  });
});
