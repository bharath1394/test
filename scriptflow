const fs = require('fs');
const path = require('path');

const stage = process.env.stage;
const accountId = process.env.accountId;
const TargetAccountRegion = process.env.TargetAccountRegion;
const resourceFullName = process.env.resourceFullName;

const flowConfigPath = path.resolve(__dirname, `../config/flows/flowConfig.json`);
const connectInstancePath = path.resolve(__dirname, `../config/${stage}/connectInstance.json`);
const controllerPath = path.resolve(__dirname, `../controller.json`);

function logInfo(msg) {
  console.log(`[INFO] ${msg}`);
}
function logWarn(msg) {
  console.warn(`[WARN] ${msg}`);
}
function logError(msg) {
  console.error(`[ERROR] ${msg}`);
  process.exit(1);
}

function safeReadJson(filePath, name) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  } catch (err) {
    logError(`Failed to read ${name} at ${filePath}: ${err.message}`);
  }
}

function getLambdaMode(controller) {
  const mode = controller?.lambda?.toUpperCase();
  if (mode === 'G' || mode === 'B') return mode;
  logWarn(`Missing/invalid lambda mode in controller.json. Defaulting to 'G'`);
  return 'G';
}

function transformLambdaArns(content, lambdaMode) {
  return content.replace(
    /arn:aws:lambda:[^:]+:\d{12}:function:[^"]+/g,
    (match) => {
      const suffix = match.split(':').pop()?.split('-').pop();
      const updated = `arn:aws:lambda:${TargetAccountRegion}:${accountId}:function:${resourceFullName}-${lambdaMode}-${suffix}`;
      logInfo(`Replaced Lambda ARN: ${match} → ${updated}`);
      return updated;
    }
  );
}

function transformFlowParameters(flowJson) {
  const actions = flowJson.Actions || [];
  const metadata = flowJson.ActionMetaData || {};

  for (const action of actions) {
    const actionId = action.Identifier;
    const params = action.parameters;
    const type = action.Type;
    const meta = metadata[actionId]?.parameters;

    if (!params || !meta) continue;

    if (type === 'TransferToFlow' && params.ContactFlowId && meta.ContactFlowId?.displayName) {
      const displayName = meta.ContactFlowId.displayName;
      const ssmRef = `\${ssm:/${stage}/flows/${displayName}/arn}`;
      logInfo(`Replaced ContactFlowId (${actionId}) with ${ssmRef}`);
      params.ContactFlowId = ssmRef;
    }

    if (type === 'InvokeFlowModule' && params.FlowModuleId && meta.FlowModuleId?.displayName) {
      const displayName = meta.FlowModuleId.displayName;
      const ssmRef = `\${ssm:/${stage}/modules/${displayName}/id}`;
      logInfo(`Replaced FlowModuleId (${actionId}) with ${ssmRef}`);
      params.FlowModuleId = ssmRef;
    }
  }

  return flowJson;
}

// MAIN EXECUTION
logInfo(`Starting flow transformation for stage: ${stage}`);
logInfo(`Account ID: ${accountId}, Region: ${TargetAccountRegion}, Prefix: ${resourceFullName}`);

const flowConfig = safeReadJson(flowConfigPath, 'flowConfig.json');
const connectInstance = safeReadJson(connectInstancePath, `${stage}/connectInstance.json`);
const controller = safeReadJson(controllerPath, 'controller.json');

const instanceName = connectInstance?.connectInstances?.[0]?.instanceName;
if (!instanceName) logWarn(`Instance name not found in ${stage}/connectInstance.json`);

const lambdaMode = getLambdaMode(controller);

const stageFlows = flowConfig[stage];
if (!stageFlows) logError(`No flows found for stage: ${stage}`);

const flowPaths = stageFlows[instanceName];
if (!flowPaths) logError(`No flows found for instance: ${instanceName} in stage: ${stage}`);

flowPaths.forEach((flowRelPath) => {
  const fullPath = path.resolve(__dirname, '../config/flows/', flowRelPath);
  logInfo(`Processing flow: ${flowRelPath}`);

  try {
    const originalText = fs.readFileSync(fullPath, 'utf-8');
    const lambdaReplaced = transformLambdaArns(originalText, lambdaMode);
    const flowJson = JSON.parse(lambdaReplaced);
    const updatedFlow = transformFlowParameters(flowJson);

    fs.writeFileSync(fullPath, JSON.stringify(updatedFlow, null, 2));
    logInfo(`✅ Successfully updated flow: ${flowRelPath}`);
  } catch (err) {
    logError(`❌ Error updating flow ${flowRelPath}: ${err.message}`);
  }
});
