// transformFlows.js
const fs = require('fs');
const path = require('path');

const stage = process.env.stage;
const accountId = process.env.accountId;
const TargetAccountRegion = process.env.TargetAccountRegion;
const resourceFullName = process.env.resourceFullName;

const flowConfigPath = path.resolve(__dirname, '../config/flows/flowConfig.json');
const controllerPath = path.resolve(__dirname, '../controller.json');
const connectInstancePath = path.resolve(__dirname, `../config/${stage}/connectInstance.json`);

function logInfo(msg) {
  console.log(`[INFO] ${msg}`);
}

function logWarn(msg) {
  console.warn(`[WAR] ${msg}`);
}

function logDebug(msg) {
  console.log(`[DEBUG] ${msg}`);
}

function transformLambdaArns(content, lambdaMode) {
  return content.replace(
    /arn:aws:lambda:[^:]+:\d{12}:function:[^"]+/g,
    (match) => {
      const suffix = match.split(':').pop()?.split('-').pop();
      const updated = `arn:aws:lambda:${TargetAccountRegion}:${accountId}:function:${resourceFullName}-${lambdaMode}-${suffix}`;
      logInfo(`Replaced Lambda ARN:\n  [OLD] ${match}\n  [NEW] ${updated}`);
      return updated;
    }
  );
}

function transformFlowContent(content) {
  let json;
  try {
    json = JSON.parse(content);
  } catch (err) {
    logWarn(`Failed to parse JSON: ${err}`);
    return content;
  }

  const metadataBlock = json.Metadata || {};
  logDebug('========== DEBUG: RAW Metadata Block ==========');
  console.dir(metadataBlock, { depth: null });
  logDebug(`metadataBlock keys: ${Object.keys(metadataBlock)}`);

  const actionMetaData = metadataBlock['ActionMetaData'];
  logDebug('========== DEBUG: RAW ActionMetaData ==========');
  console.dir(actionMetaData, { depth: null });
  logDebug(`Total ActionMetaData Entries Found: ${actionMetaData ? Object.keys(actionMetaData).length : 0}`);

  const actions = json.Actions || [];
  logDebug('========== DEBUG: Actions ==========');
  logDebug(`Total Actions Found: ${actions.length}`);

  for (const action of actions) {
    const identifier = action.Identifier;
    const type = action.Type;
    const parameters = action.Parameters || {};

    if (!identifier || !parameters) continue;

    const meta = actionMetaData?.[identifier];
    if (!meta || !meta.parameters) {
      logWarn(`Missing metadata for Identifier: ${identifier}`);
      continue;
    }

    for (const [paramKey, paramValue] of Object.entries(parameters)) {
      const displayName = meta.parameters?.[paramKey]?.displayName;
      if (!displayName) continue;

      if (paramKey === 'ContactFlowId') {
        const ssmPath = `\${ssm:/${stage}/flows/${displayName}/arn}`;
        logInfo(`Replacing ContactFlowId for action ${identifier} with: ${ssmPath}`);
        parameters[paramKey] = ssmPath;
      }

      if (paramKey === 'FlowModuleId') {
        const ssmPath = `\${ssm:/${stage}/modules/${displayName}/id}`;
        logInfo(`Replacing FlowModuleId for action ${identifier} with: ${ssmPath}`);
        parameters[paramKey] = ssmPath;
      }
    }
  }

  return JSON.stringify(json, null, 2);
}

function main() {
  const controller = JSON.parse(fs.readFileSync(controllerPath, 'utf8'));
  const lambdaMode = controller.mode;
  logInfo(`Lambda mode from controller: ${lambdaMode}`);

  const flowConfig = JSON.parse(fs.readFileSync(flowConfigPath, 'utf8'));
  const flowList = flowConfig[stage]?.['connect-instance'] || [];

  const connectInstance = JSON.parse(fs.readFileSync(connectInstancePath, 'utf8'));
  const instanceName = connectInstance.connectInstances?.[0]?.instanceName;
  if (!instanceName) {
    logWarn(`Instance ID not found for ${stage} / ${instanceName}`);
  }

  flowList.forEach((relativePath) => {
    const fullPath = path.resolve(__dirname, `../src/${relativePath}`);
    if (!fs.existsSync(fullPath)) {
      logWarn(`Flow file not found: ${fullPath}`);
      return;
    }

    const content = fs.readFileSync(fullPath, 'utf8');
    const transformedContent = transformLambdaArns(content, lambdaMode);
    const finalContent = transformFlowContent(transformedContent);

    fs.writeFileSync(fullPath, finalContent, 'utf8');
    logInfo(`✅ Updated flow file: ${fullPath}`);
  });
}

main();
